# AI Provider: openai(OpenAI Responses API) 또는 openai_compatible(vLLM 등 Chat Completions)
AI_PROVIDER=openai

# --- openai ---
# 기존 OPENAI_* 이름도 계속 읽습니다. AI_API_KEY/AI_MODEL/AI_TIMEOUT_SECONDS가 있으면 그 값을 우선합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=30
# 추론 모델의 사고량(minimal|low|medium|high). 낮을수록 첫 글자가 빨라집니다. 비우면 Provider 기본값(medium)입니다.
AI_REASONING_EFFORT=low

# --- openai_compatible (vLLM) ---
# compose.vllm.yaml은 아래 세 값을 자동으로 설정합니다.
# AI_BASE_URL=http://vllm:8000/v1
# AI_MODEL=qwen3-32b-awq
# vLLM --api-key를 쓰는 경우에만 설정합니다.
# AI_API_KEY=
# Qwen3 등 사고 모드가 있는 모델의 사고 출력을 끕니다(기본 true).
# AI_DISABLE_THINKING=true
# 응답 최대 토큰 수(선택)
# AI_MAX_OUTPUT_TOKENS=2048

# --- 공통 ---
# 첫 토큰 전 연결 오류·429·5xx 재시도 횟수(기본 2, 지수 백오프)
# AI_MAX_RETRIES=2
# 준비된 환자 문맥의 메모리 보관 시간(초, 기본 43200=12시간)과 최대 환자 수(기본 1000)
# AX_G_PATIENT_CONTEXT_TTL_SECONDS=43200
# AX_G_PATIENT_CONTEXT_MAX_ENTRIES=1000

# --- compose.vllm.yaml 전용 ---
# AX_G_AI_IMAGE=ax-g-ai:1.0.0
# VLLM_MODEL=Qwen/Qwen3-32B-AWQ
# VLLM_MAX_MODEL_LEN=16384
# VLLM_GPU_MEMORY_UTILIZATION=0.90
# HF_TOKEN=
# HF_CACHE_DIR=./hf-cache
# HF_HUB_OFFLINE=0

# --- 최신화 근거 인용·말뭉치 DB (compose.yaml·compose.vllm.yaml) ---
# 말뭉치 PostgreSQL 비밀번호(필수, compose가 postgres·corpus-loader·ax-g-ai에 전달). 충분히 긴 임의 값을 쓰세요.
CORPUS_DB_PASSWORD=
# CORPUS_DB_USER=axg
# CORPUS_DB_NAME=axg_corpus
# 의료진 미검수 근거도 '미검수' 표시와 함께 인용할지(기본 false)
# AX_G_EVIDENCE_INCLUDE_UNREVIEWED=false
# 질문당 인용 근거 수(1~5, 기본 3)와 의미 검색만으로 인용할 최소 코사인 유사도(기본 0.6)
# AX_G_EVIDENCE_MAX_CHUNKS=3
# AX_G_EVIDENCE_SIMILARITY_FLOOR=0.6
# 임베딩 서버(TEI CPU, KURE-v1) 자원. 4GB 미만이면 모델 적재 중 OOM이 납니다.
# EMBEDDING_MEM_LIMIT=6g
# EMBEDDING_CPUS=4
# ARM 서버: EMBEDDING_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9.4

AX_G_PORT=8100
