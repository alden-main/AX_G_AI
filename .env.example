# 서버별 비밀값만 둡니다. 이 파일은 git·배포 압축에 값 없이 포함되며, 서버에서 .env로 복사해(권한 600) 채웁니다.
# 비밀이 아닌 설정(모델·GPU 번호·포트·바인딩·샘플링·자원 한도 등)은 compose 파일의 ${이름:-기본값}과 코드 기본값에 있습니다.
# 그런 값을 바꿀 때는 이 파일이 아니라 compose 파일을 고칩니다.
# 비밀번호는 DB·Redis 접속 URL에 들어가므로 영숫자만 씁니다. 예: openssl rand -hex 24

# 말뭉치 PostgreSQL 비밀번호(필수). 기존 corpus-db 볼륨을 처음 만들 때 쓴 값과 같아야 합니다.
CORPUS_DB_PASSWORD=

# OpenAI API 키(openai 모드일 때만 필수)
OPENAI_API_KEY=

# Redis 비밀번호(--redis 사용 시 필수)
REDIS_PASSWORD=

# 자체 추론 서버를 --api-key로 띄운 경우에만
# AI_API_KEY=

# gated Hugging Face 모델을 내려받을 때만
# HF_TOKEN=

# AI 호출 추적 화면(Phoenix, --observability 사용 시 필수). 각각 32자 이상·숫자와 소문자 포함, 서로 다르게.
# PHOENIX_SECRET=
# PHOENIX_ADMIN_SECRET=
# 화면 로그인(admin@localhost) 최초 비밀번호
# PHOENIX_ADMIN_PASSWORD=
