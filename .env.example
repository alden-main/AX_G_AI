# AI Provider: openai(OpenAI Responses API) 또는 openai_compatible(vLLM 등 Chat Completions)
AI_PROVIDER=openai

# --- openai ---
# 기존 OPENAI_* 이름도 계속 읽습니다. AI_API_KEY/AI_MODEL/AI_TIMEOUT_SECONDS가 있으면 그 값을 우선합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=30
# 추론 모델의 사고량(minimal|low|medium|high). 낮을수록 첫 글자가 빨라집니다. 비우면 Provider 기본값(medium)입니다.
AI_REASONING_EFFORT=low

# --- openai_compatible (vLLM) ---
# compose.vllm.yaml은 아래 세 값을 자동으로 설정합니다.
# AI_BASE_URL=http://vllm:8000/v1
# AI_MODEL=qwen3-32b-awq
# vLLM --api-key를 쓰는 경우에만 설정합니다.
# AI_API_KEY=
# Qwen3 등 사고 모드가 있는 모델의 사고 출력을 끕니다(기본 true).
# AI_DISABLE_THINKING=true
# 응답 최대 토큰 수(선택)
# AI_MAX_OUTPUT_TOKENS=2048

# --- 공통 ---
# 첫 토큰 전 연결 오류·429·5xx 재시도 횟수(기본 2, 지수 백오프)
# AI_MAX_RETRIES=2
# 준비된 환자 문맥의 메모리 보관 시간(초, 기본 43200=12시간)과 최대 환자 수(기본 1000)
# AX_G_PATIENT_CONTEXT_TTL_SECONDS=43200
# AX_G_PATIENT_CONTEXT_MAX_ENTRIES=1000

# --- compose.vllm.yaml 전용 ---
# AX_G_AI_IMAGE=ax-g-ai:1.0.0
# VLLM_MODEL=Qwen/Qwen3-32B-AWQ
# VLLM_MAX_MODEL_LEN=16384
# VLLM_GPU_MEMORY_UTILIZATION=0.90
# HF_TOKEN=
# HF_CACHE_DIR=./hf-cache
# HF_HUB_OFFLINE=0

# --- 심평원 DUR 처방 점검 (병용금기·연령금기·임부금기·노인주의) ---
# 말뭉치와 같은 PostgreSQL의 dur 스키마에서 읽습니다(AX_G_CORPUS_DATABASE_URL). 갱신 순서:
#   1) 공공데이터포털 「건강보험심사평가원_의약품안전사용서비스(DUR) 의약품 목록」(공공누리 제1유형) CSV를 dur/ 에 둠
#   2) uv run ax-g-ai-build-dur --input dur --output data/dur --replace   (스냅샷 생성, 이미지에 포함)
#   3) 이미지 빌드 후 compose 기동 → dur-loader 가 새 데이터셋을 적재·활성화(같은 내용이면 건너뜀)
# DB나 활성 데이터셋이 없으면 경고 로그 후 DUR 점검을 끕니다.
# AX_G_DUR_ENABLED=true

# --- 출처 표시 가능 자료만 사용 (기본 true) ---
# true면 AI가 쓰는 의학 근거를 "출처를 밝히면 상업 이용 가능한"(CC0·CC BY·퍼블릭 도메인) 말뭉치로 한정합니다.
# - 근거·규칙의 출처마다 라이선스·제목이 있어야 인용(화면에 sources[].license·citation 표시)
# - 출처·라이선스 미확인 참조 DB(AX_G_REFERENCE_DATA_DB_PATH, 약품 효능·주의사항)는 설정돼 있어도 쓰지 않음
# - 추천 의견에서 출처 없는 일반 의학 지식 제안([AI 일반 지식·출처 없음])을 하지 않음
# AX_G_ATTRIBUTED_SOURCES_ONLY=true

# --- 최신화 근거 인용·말뭉치 DB (compose.yaml·compose.vllm.yaml) ---
# 말뭉치 PostgreSQL 비밀번호(필수, compose가 postgres·corpus-loader·ax-g-ai에 전달). 충분히 긴 임의 값을 쓰세요.
CORPUS_DB_PASSWORD=
# CORPUS_DB_USER=axg
# CORPUS_DB_NAME=axg_corpus
# 의료진 미검수(draft) 근거·규칙도 쓸지(코드 기본 false). 답변·응답에 미검수 경고는 붙이지 않고 출처로 근거를 밝힙니다.
# 현재 말뭉치는 전부 미검수이므로, 끄면 근거 인용·추천 진단/검사가 모두 비활성입니다. 검수 완료 후 false로 되돌리세요.
AX_G_EVIDENCE_INCLUDE_UNREVIEWED=true
# 추천 진단·검사(말뭉치 진단·검사·협진·추적 규칙을 EMR에 적용, 기본 true).
# AX_G_CLINICAL_RULES_ENABLED=true
# 약물 용량 참고(3단계, 코드 기본 false): 현재 처방·요청 약(dose_drugs)에 말뭉치 용량 규칙을 적용해
# 체중 기준 계산값, eGFR·CrCl 구간 용량, 용량 조건, 처방 1일 용량 대조를 냅니다. 현재 용량 규칙은 전부 미검수(draft)·국외 허가 기준이며
# 항목마다 출처·region이 붙습니다(AX_G_EVIDENCE_INCLUDE_UNREVIEWED=true 필요).
AX_G_CLINICAL_DOSES_ENABLED=true
# 추천 의견 하나에 붙일 규칙 근거 문단 수(1~20, 기본 10)
# AX_G_RECOMMENDATION_MAX_EVIDENCE=10
# 병원 검사·약품 코드 → 말뭉치 개념 매핑(검수된 JSON). 없으면 LOINC 검사 코드·처방명 속 성분명으로만 매핑합니다.
# 형식: text_data/mappings/sites/example.json, 초안 생성: text_data/tools/propose_site_map.py
# AX_G_SITE_CODE_MAP_PATH=/app/text_data/mappings/sites/<병원>.json
# 질문당 인용 근거 수(1~5, 기본 3)와 의미 검색만으로 인용할 최소 코사인 유사도(기본 0.6)
# AX_G_EVIDENCE_MAX_CHUNKS=3
# AX_G_EVIDENCE_SIMILARITY_FLOOR=0.6
# 임베딩 서버(TEI CPU, KURE-v1) 자원. 4GB 미만이면 모델 적재 중 OOM이 납니다.
# EMBEDDING_MEM_LIMIT=6g
# EMBEDDING_CPUS=4
# ARM 서버: EMBEDDING_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9.4

AX_G_PORT=8100
