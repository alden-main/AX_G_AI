# 서버별 비밀값만 둡니다. 이 파일은 git·배포 압축에 비밀값 없이 포함되며, 서버에서 .env로 복사해 채웁니다.
# 나머지 설정은 compose 파일과 코드 기본값에 있습니다. 서버에서만 다르게 쓰려면 같은 이름을 여기에 적습니다.

# OpenAI API 키(AI_PROVIDER=openai일 때 필수)
OPENAI_API_KEY=
# 말뭉치 PostgreSQL 비밀번호(필수). 충분히 긴 임의 값을 쓰세요.
CORPUS_DB_PASSWORD=main_corpus_g_ax+8805

# Redis 사용 시(compose.redis.yaml) 필수
REDIS_PASSWORD=main_redis_g_ax+8805
# vLLM을 --api-key로 띄운 경우에만
# AI_API_KEY=
# gated Hugging Face 모델을 받을 때만
# HF_TOKEN=

# --- 선택: 애플리케이션 설정(기본값은 compose 파일·코드) ---
# AI_REASONING_EFFORT=low  AX_G_EVIDENCE_INCLUDE_UNREVIEWED=true  AX_G_CLINICAL_DOSES_ENABLED=true   (compose 설정값)
# OPENAI_MODEL=gpt-5-mini  OPENAI_TIMEOUT_SECONDS=30  AX_G_DUR_ENABLED=true  AX_G_SITE_CODE_MAP_PATH=...   (코드 기본값)

# --- 선택: 서버 자원·이미지·포트 조정 ---
# 아래 값의 기본값은 compose 파일(${이름:-기본값})에 있습니다. 바꿀 때만 주석을 풀어 씁니다.
# CORPUS_DB_USER=axg  CORPUS_DB_NAME=axg_corpus
# EMBEDDING_MEM_LIMIT=6g  EMBEDDING_CPUS=4  EMBEDDING_MAX_BATCH_TOKENS=4096   (4GB 미만이면 모델 적재 중 OOM)
# EMBEDDING_IMAGE / EMBEDDING_CACHE_DIR / EMBEDDING_HF_HUB_OFFLINE   (배포 압축이 자동 설정)
# AX_G_WORKERS=2  REDIS_MAXMEMORY=256mb   (compose.redis.yaml)
# VLLM_MODEL=Qwen/Qwen3-32B-AWQ  AI_MODEL=qwen3-32b-awq  VLLM_MAX_MODEL_LEN=16384  VLLM_GPU_MEMORY_UTILIZATION=0.90
# HF_CACHE_DIR=./hf-cache  HF_HUB_OFFLINE=0  AX_G_PORT=8100   (compose.vllm.yaml)
# AX_G_DEPENDENCY_STARTUP_WAIT_SECONDS=120
